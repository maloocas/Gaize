# Provider chain, tried in order. First one that returns valid candidates wins.
# openrouter = best constraint satisfaction (~98%); ollama = local/offline;
# constrained = built-in offline generator, always available, no model needed.
AAC_PROVIDER_CHAIN=openrouter,constrained

OPENROUTER_API_KEY=

# Native swipe keyboard: whole-sentence decoding (native/llm.py). Optional;
# without it each word falls back to its top swipe candidate.
OPENAI_API_KEY=
AAC_OPENROUTER_MODEL=google/gemini-2.5-flash

OLLAMA_HOST=http://localhost:11434
AAC_OLLAMA_MODEL=llama3.2:3b

AAC_N_CANDIDATES=4
AAC_CONTEXT_TURNS=4
AAC_TIMEOUT=12
